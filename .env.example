GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AUTH_SECRET=
AUTH_URL=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated Google access restrictions.
# When both are empty, any verified Google account can sign in.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

LARK_CLIENT_ID=
LARK_CLIENT_SECRET=
LARK_OAUTH_SCOPES=contact:user.base:readonly

# Optional comma-separated access restrictions.
# Leave both empty to rely on the Lark app's availability settings.
LARK_ALLOWED_TENANT_KEYS=
LARK_ALLOWED_OPEN_IDS=
